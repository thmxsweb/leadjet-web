# Auth.js
AUTH_SECRET=change-me
# App URL (used in verification + CLI link URLs). Local dev default below.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas (free M0). Create at https://cloud.mongodb.com -> Connect -> Drivers
MONGODB_URI=mongodb+srv://user:pass@cluster.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=leadjet

# Resend (email verification). https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxx
EMAIL_FROM=leadjet <onboarding@resend.dev>
